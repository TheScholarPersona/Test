# Lokale Umgebung. `pnpm env:init` legt daraus die .env an und füllt alle
# leeren Geheimnisse mit Zufallswerten; vorhandene Werte bleiben erhalten.
# docker compose, `pnpm test:e2e`, `pnpm test:web` und `pnpm demo:data` lesen die .env.
# Die .env gehört nicht ins Repository (steht in .gitignore).

# --- Ports auf diesem Rechner (nur 127.0.0.1) ---------------------------------
# Anpassen, wenn ein Port schon belegt ist (z. B. andere Node-RED-Instanz auf 1880).
WMS_API_PORT=3000
WMS_NODE_RED_PORT=1880
WMS_POSTGRES_PORT=5432
# MQTT nur noch mit TLS (im Container Port 8883)
WMS_MQTT_PORT=8883
# Nur für `pnpm web:dev` (Vite-Entwicklungsserver der Oberfläche)
WMS_WEB_DEV_PORT=5174

# --- Geheimnisse (leer lassen: `pnpm env:init` erzeugt sie) --------------------
# Benutzer `admin` der Oberfläche/API (wird beim ersten Start angelegt)
WMS_ADMIN_PASSWORD=
# Service-Token, mit dem Node-RED (Szenarien, Simulator, Beispiel-Flows) die API aufruft
WMS_NODE_RED_API_TOKEN=
# Node-RED-Editor: Benutzer `admin`
WMS_NODE_RED_ADMIN_PASSWORD=
# HTTP-Endpunkte von Node-RED (/test, /sim, /examples): Benutzer `wms`
WMS_NODE_RED_HTTP_PASSWORD=
# MQTT-Benutzer
WMS_MQTT_API_PASSWORD=
WMS_MQTT_NODE_RED_PASSWORD=
WMS_MQTT_HEALTH_PASSWORD=
# Datenbank
WMS_POSTGRES_PASSWORD=
