# Ports der lokalen Umgebung auf diesem Rechner (nur 127.0.0.1).
# Kopieren nach .env und anpassen, wenn ein Port schon belegt ist –
# z. B. durch eine andere Node-RED-Instanz auf 1880.
# docker compose und `pnpm test:e2e` lesen diese Datei.
WMS_API_PORT=3000
WMS_NODE_RED_PORT=1880
WMS_POSTGRES_PORT=5432
WMS_MQTT_PORT=1883
