# Beispielkonfiguration für den lokalen Start ohne Docker (pnpm --filter @wms/api start).
# Werte werden beim Start geprüft; siehe src/config.ts.
APP_PROFILE=development
PORT=3000
DATABASE_URL=postgresql://wms:wms@localhost:5432/wms
DB_MIGRATE_ON_START=true
MQTT_URL=mqtt://localhost:1883
OUTBOX_RELAY_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_PUBLISH_TIMEOUT_MS=5000
