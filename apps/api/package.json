{
  "name": "@wms/api",
  "version": "0.1.0",
  "private": true,
  "description": "WMS-Kern: REST-API, Domänenmodule, Outbox → MQTT",
  "type": "module",
  "main": "./dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "node dist/scripts/migrate.js up",
    "db:migration:create": "node dist/scripts/migrate.js create"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@mikro-orm/core": "7.2.10",
    "@mikro-orm/migrations": "7.2.10",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.2.10",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@wms/shared": "workspace:*",
    "bwip-js": "4.11.4",
    "mqtt": "5.16.1",
    "pdfkit": "0.20.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.5.0",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "22.20.5",
    "@types/pdfkit": "0.17.7",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
