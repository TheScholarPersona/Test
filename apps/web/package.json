{
  "name": "@wms/web",
  "version": "0.1.0",
  "private": true,
  "description": "Oberfläche des WMS: Leitstand und Scanner-Ansicht",
  "type": "module",
  "scripts": {
    "generate": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts --default-non-nullable false",
    "dev": "pnpm generate && vite",
    "build": "pnpm generate && tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "pnpm generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "@playwright/test": "1.63.0"
  }
}
