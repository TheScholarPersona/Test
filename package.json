{
  "name": "wms",
  "private": true,
  "description": "Warehouse-Management-System (TypeScript, NestJS, PostgreSQL, MQTT, Node-RED)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint:deps": "depcruise apps/api/src packages/shared/src --config .dependency-cruiser.cjs",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @wms/api test:integration",
    "test:e2e": "pnpm --filter @wms/scenario-runner test:e2e",
    "verify": "pnpm build && pnpm typecheck && pnpm lint:deps && pnpm test",
    "stack:up": "docker compose up -d --build --wait",
    "stack:down": "node scripts/stack-down.mjs",
    "demo:data": "node scripts/demo-data.mjs",
    "journal:anchor": "node scripts/journal.mjs anchor",
    "journal:verify": "node scripts/journal.mjs verify",
    "web:dev": "pnpm --filter @wms/web dev",
    "test:web": "pnpm --filter @wms/web test:e2e",
    "env:init": "node scripts/init-env.mjs",
    "catalog:check": "node packages/feature-catalog/src/cli.ts check",
    "catalog:build": "node packages/feature-catalog/src/cli.ts build"
  },
  "devDependencies": {
    "dependency-cruiser": "18.7.2",
    "typescript": "6.0.3"
  }
}
